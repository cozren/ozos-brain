# Copy to .env (ozos init does this for you). Never commit .env.

# LLM — required
ANTHROPIC_API_KEY=sk-ant-...your-key-here...
# Optional: an Anthropic-compatible proxy (employer gateway) and a model override
OZOS_LLM_BASE_URL=
OZOS_LLM_MODEL=claude-sonnet-5-5

# ── Connectors (fill in only the ones you enable in Setup) ──────────────────

# Atlassian (Confluence search, Goals)
# ATLASSIAN_EMAIL=you@yourcompany.com
# ATLASSIAN_TOKEN=            # https://id.atlassian.net/manage-profile/security/api-tokens
# ATLASSIAN_SUBDOMAIN=        # the part before .atlassian.net
# ATLASSIAN_CLOUD_ID=

# Metabase (read-only REST)
# METABASE_URL=https://metabase.example.com
# METABASE_API_KEY=
# METABASE_USERNAME=
# METABASE_PASSWORD=

# Gmail / Google Drive (meeting notes): OAuth client file + token live outside the vault
#   ~/.gdrive-credentials.json and ~/.config/ozos/meeting-notes-token.json
